# frontend/Dockerfile.dev
# Fitness Garage — Frontend (Vite + React + TypeScript)
# Development only — hot reload enabled
# Production: Vercel auto-builds from GitHub (no Dockerfile needed)

FROM node:20-alpine

# Set working directory
WORKDIR /app

# Install dependencies first (layer caching)
COPY package.json package-lock.json ./
RUN npm ci

# Copy config files
COPY vite.config.ts tsconfig.json tsconfig.node.json tailwind.config.ts postcss.config.js ./
COPY index.html ./

# Copy source (overridden by volume mount in docker-compose for hot reload)
COPY src/ ./src/
COPY public/ ./public/

# Expose Vite dev server port
EXPOSE 5173

# Start Vite dev server
# --host exposes to all interfaces so Docker port mapping works
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
