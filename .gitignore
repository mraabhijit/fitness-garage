# ─────────────────────────────────────────────────────────────
# ROOT .gitignore — Fitness Garage (v2 — Static Frontend Only)
# ─────────────────────────────────────────────────────────────

# ─── Environment & secrets ───────────────────────────────────
# CRITICAL: Never commit API keys — VITE_GOOGLE_PLACES_API_KEY must stay local
.env
.env.local
.env.*.local
.env.production
.env.staging
*.pem
*.key
*.cert
.secrets.baseline

# ─── OS generated ────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── Editor ──────────────────────────────────────────────────
.vscode/settings.json
.vscode/launch.json
.idea/
*.swp
*.swo
*~

# ─── Logs ────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─────────────────────────────────────────────────────────────
# FRONTEND — frontend/
# ─────────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/

# ─────────────────────────────────────────────────────────────
# DOCKER
# ─────────────────────────────────────────────────────────────
docker-compose.override.yml

# ─────────────────────────────────────────────────────────────
# TOOLS & CLI
# ─────────────────────────────────────────────────────────────
.pre-commit-run-cache/
.lighthouseci/
.gemini/

# ─────────────────────────────────────────────────────────────
# BACKEND (Python / FastApi / Pytest)
# ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.venv/
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
backend/**/*.pyc
backend/.mypy_cache/
backend/.pytest_cache/
backend/.coverage
backend/htmlcov/
backend/dist/
